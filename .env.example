# Environment Variables
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Vibe Manager free model routing (all secrets stay server-side)
# Configure comma-separated OpenRouter IDs ending in :free in the Admin > Vibe Manager page.
# Vibe Manager tries each configured free model in order; model names are never shown to users.
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# Set true only when this key is on Groq's no-charge Free tier (never a paid Developer tier).
GROQ_FREE_TIER_CONFIRMED=false
# Optional Groq fallback model. It is only called when GROQ_FREE_TIER_CONFIRMED=true.
GROQ_FREE_MODEL=openai/gpt-oss-20b

# TMDB API - live API use requires a permitted usage mode (see docs/blueprint-progress.md)
TMDB_API_KEY=your_tmdb_api_key
TMDB_NONCOMMERCIAL_USE_CONFIRMED=false
TMDB_COMMERCIAL_LICENSE_CONFIRMED=false
